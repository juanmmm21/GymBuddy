{
  "name": "@gymbuddy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node -e \"require('node:fs').mkdirSync('../web/dist', { recursive: true })\" && wrangler dev",
    "deploy": "wrangler deploy --env production",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply gymbuddy --local",
    "db:migrate:remote": "wrangler d1 migrations apply gymbuddy --remote --env production",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@gymbuddy/shared": "workspace:*",
    "@simplewebauthn/server": "14.0.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "zod": "^4.5.4"
  },
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
